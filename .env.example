# OrcaRouter (OpenAI互換) https://www.orcarouter.ai/
ORCAROUTER_API_KEY=sk-orca-xxxx
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# モデル階層（コスト測定で差し替える）
MODEL_CHEAP=deepseek/deepseek-v4.1-flash
MODEL_MAIN=deepseek/deepseek-v4.1-flash   # auto は推論モデルに振られて遅いことがあった（replay で計測）
MODEL_STRONG=anthropic/claude-opus-4.8
# 要求したモデルが落ちているときに順に試す（カンマ区切り）
MODEL_FALLBACK=orcarouter/auto,anthropic/claude-sonnet-5
LLM_TIMEOUT_MS=45000

# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-xxxx
SLACK_APP_TOKEN=xapp-xxxx

# Google Calendar (OAuth クライアント。scripts/gcal-auth.ts で本人が許可)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# その他
DB_PATH=data/jiiya.db
