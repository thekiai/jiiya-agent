{
  "name": "jiiya-agent",
  "version": "0.1.0",
  "private": true,
  "description": "じいやエージェント — Slack に住む執事 AI。本人宛てのメンションに執事の名前で返す",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gcal:auth": "tsx scripts/gcal-auth.ts",
    "replay": "tsx scripts/replay.ts"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.1",
    "googleapis": "^181.0.0",
